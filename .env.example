# cp .env.example .env  후에 값을 채우세요. .env 는 커밋되지 않습니다.
OPENAI_API_KEY=sk-...
# 디스코드 채널 → 연동 → 웹후크 → 새 웹후크 → URL 복사
# 주의: 이 URL 자체가 비밀번호입니다. 아는 사람은 누구나 그 채널에 글을 쓸 수 있습니다.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
# 국내 전시 정보용. data.go.kr → '한국문화정보원 공연전시정보' 활용 신청
KCISA_SERVICE_KEY=

# 1 = 보내지 않음(기본), 0 = 실제 발행
DRY_RUN=1
